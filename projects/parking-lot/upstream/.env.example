# Copy to .env and fill in real values. Never commit the real .env file.

APP_NAME="Parking Management API"
API_PREFIX=/api

# Running via `docker compose up` (service name "db"):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/parking
# Running the backend directly on the host against a local Postgres instead:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/parking

# Generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_A_RANDOM_32+_BYTE_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

EVIDENCE_STORAGE_PATH=./data/evidence

# Comma-separated list of allowed origins for the Flutter web build.
# Dev default is "*" (see config.py) — restrict this in production, e.g.:
# CORS_ORIGINS=https://your-app-domain.example
CORS_ORIGINS=*
